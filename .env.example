# Copy this file to .env and fill in your own values. .env is never committed.
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio WhatsApp sandbox number, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=
PORT=3000

# Optional: a second WhatsApp number (joined to the sandbox) that gets family alerts, e.g. whatsapp:+886912345678
FAMILY_WHATSAPP_TO=
# Optional: pin the dose slot while recording (morning | noon | evening | bedtime)
DEMO_SLOT=morning

# Optional, for phone calls on a red alert: your Twilio phone number, e.g. +15551234567
TWILIO_VOICE_FROM=
# Optional, for phone calls: your ngrok https URL, no trailing slash
PUBLIC_URL=

# Optional: her WhatsApp number, e.g. whatsapp:+886912345678. If empty, the first person to message Kinly is her.
ELDER_WHATSAPP=
# Optional: the care team number (joined to the sandbox)
CARE_WHATSAPP_TO=
# Optional: her daughter's name, used in Kinly's messages
FAMILY_NAME=Anna

# Optional: Kinly says "I miss you" after this many quiet minutes (e.g. 2 while recording)
QUIET_MINUTES=

# Telegram bot token from @BotFather. With this set, Kinly talks in Telegram.
TELEGRAM_BOT_TOKEN=

# Gemini API key (aistudio.google.com/apikey). Kinly uses Gemini to watch photos and videos.
GEMINI_API_KEY=
# Gemini model id, e.g. the newest flash model
GEMINI_MODEL=

# Optional, for a one-account demo: two more bots that stand in for the family and care team phones
TELEGRAM_FAMILY_BOT_TOKEN=
TELEGRAM_CARE_BOT_TOKEN=
